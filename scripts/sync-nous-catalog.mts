/**
 * Sync the Nous Portal model catalog into a generated advisory pricing table.
 *
 * Pulls https://inference-api.nousresearch.com/v1/models (no auth), filters to
 * routable TEXT LLMs (tool support turned on, real >0 price, context >= 128k,
 * no media/embedding), infers tier + capabilities from price/modality/reasoning,
 * and writes `src/catalog/nous.generated.ts` as NOUS_GENERATED_PRICING — a
 * bounded, hand-reviewable table that DEFAULT_PRICING merges for live-ish
 * advisory costs on the Nous-hosted models Shipyard can route to.
 *
 * This is a GENERATED artifact and MUST be re-run to stay fresh — it is checked
 * in so the gateway never needs a network call at runtime.
 *
 *   node --import tsx scripts/sync-nous-catalog.mts [--task coding]
 *
 * `--task` prints a recommendation table for that workload (coding | refactor |
 * bulk | chat) alongside the generated file. Default: coding.
 */
import { writeFileSync } from 'node:fs'
import { resolve } from 'node:path'

const NOUS_MODELS_URL = 'https://inference-api.nousresearch.com/v1/models'
const OUT_PATH = resolve(import.meta.dirname, '../src/catalog/nous.generated.ts')
const LIMIT = 40 // keep the generated table / catalog page bounded and reviewable

type Raw = {
  id: string
  name?: string
  context_length?: number | null
  pricing?: { prompt?: string; completion?: string; input_cache_read?: string }
  supported_parameters?: string[]
  architecture?: {
    input_modalities?: string[]
    modality?: string
  }
  reasoning?: { mandatory?: boolean }
  description?: string
}

interface Row {
  model: string
  input: number
  output: number
  cacheRead?: number
  context: number
  tier: 'economy' | 'standard' | 'frontier'
  capabilities: string[]
}

const unused = (s?: string | null): boolean => !s || s.trim() === ''

const usdPerMTok = (perToken?: string): number => {
  const n = Number(perToken ?? 0)
  return n <= 0 ? 0 : Math.round(n * 1e6 * 1e4) / 1e4
}

/** Quality tier from blended (in+out) price. Thresholds are advisory. */
function inferTier(blended: number): Row['tier'] {
  if (blended <= 0.5) return 'economy'
  if (blended <= 3) return 'standard'
  return 'frontier'
}

async function main(): Promise<void> {
  const res = await fetch(NOUS_MODELS_URL)
  if (!res.ok) throw new Error(`Nous models endpoint returned ${res.status}`)
  const json = (await res.json()) as { data: Raw[] }
  const data = json.data ?? []

  const rows: Row[] = []
  for (const m of data) {
    const price = m.pricing ?? {}
    const input = usdPerMTok(price.prompt)
    const output = usdPerMTok(price.completion)
    // Skip free / embedding / media: free has no billing meaning; media isn't a
    // routable token-priced LLM. Require tool support (long agent loops).
    if (unused(m.id) || input + output <= 0 || !(m.supported_parameters ?? []).includes('tools')) {
      continue
    }
    const context = Number(m.context_length ?? 0)
    if (context < 128_000) continue
    const inputs = m.architecture?.input_modalities ?? []
    const hasVision = inputs.some((i) => ['image', 'video'].includes(i))
    const hasReasoning = m.reasoning?.mandatory ?? (m.supported_parameters ?? []).includes('reasoning')
    const caps: string[] = ['tools']
    if (hasVision) caps.push('vision')
    if (hasReasoning) caps.push('reasoning')
    const cacheRead = usdPerMTok(price.input_cache_read)
    rows.push({
      model: m.id,
      input,
      output,
      ...(cacheRead > 0 ? { cacheRead } : {}),
      context,
      tier: inferTier(input + output),
      capabilities: caps,
    })
  }

  // Sort by blended cost, take the bounded head (keeps the catalog page sane).
  rows.sort((a, b) => a.input + a.output - (b.input + b.output))
  const head = rows.slice(0, LIMIT)

  const body = `// GENERATED by scripts/sync-nous-catalog.mts — DO NOT EDIT BY HAND.
// Source: ${NOUS_MODELS_URL} (no auth). Re-run: \`npm run sync:nous\`.
// Advisory USD per 1M tokens + capabilities for the Nous-hosted text LLMs
// Shipyard can route to. DEFAULT_PRICING merges this beneath hand-curated keys
// (hand-curated wins on conflict). Generated ${new Date().toISOString()}.
export interface NousGeneratedRow {
  inputCostPerMTok: number
  outputCostPerMTok: number
  cacheReadCostPerMTok?: number
  contextWindow: number
  tier: 'economy' | 'standard' | 'frontier'
  capabilities: string[]
}
export const NOUS_GENERATED_PRICING: Record<string, NousGeneratedRow> = {
${head
  .map(
    (r) => `  ${JSON.stringify(r.model)}: {
    inputCostPerMTok: ${r.input},
    outputCostPerMTok: ${r.output},${r.cacheRead ? `\n    cacheReadCostPerMTok: ${r.cacheRead},` : ''}
    contextWindow: ${r.context},
    tier: '${r.tier}',
    capabilities: [${r.capabilities.map((c) => `'${c}'`).join(', ')}],
  },`,
  )
  .join('\n')}
}
`

  writeFileSync(OUT_PATH, body)

  // Task-type recommendation helper (mirrors the nous-model-picker skill).
  const task = process.argv.find((a) => a === '--task') ? process.argv[process.argv.indexOf('--task') + 1] ?? 'coding' : 'coding'
  const isCoding = ['coding', 'refactor'].includes(task)
  const pool = rows.filter((r) => (isCoding ? r.capabilities.includes('tools') : true))
  const rec = pool
    .filter((r) => (task === 'refactor' ? r.tier !== 'economy' : true))
    .sort((a, b) => a.input + a.output - (b.input + b.output))
    .slice(0, 5)

  console.log(`Synced ${rows.length} routable Nous LLMs; wrote ${head.length} to ${OUT_PATH}\n`)
  console.log(`Recommendation for task '${task}' (cheapest first, tools-capable):`)
  for (const r of rec) {
    console.log(
      `  ${r.model.padEnd(52)} in $${r.input.toFixed(3).padStart(6)} out $${r.output.toFixed(3).padStart(6)} ctx ${String(r.context).padStart(8)} tier ${r.tier.padEnd(8)} [${r.capabilities.join(',')}]`,
    )
  }
  console.log(`\n${rows.length} total routable | top 5 shown. Edit scripts/sync-nous-catalog.mts LIMIT to widen.`)
}

main().catch((err) => {
  console.error(err)
  process.exit(1)
})
